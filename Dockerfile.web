FROM ocaml/opam:ubuntu-24.04-ocaml-4.13 AS build

USER opam
WORKDIR /home/opam/marina

COPY --chown=opam:opam . .

RUN opam install -y ocamlfind ounit2 \
    && eval $(opam env) \
    && make

    FROM ubuntu:24.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages flask flask-cors

WORKDIR /app
COPY --from=build /home/opam/marina/marina .
COPY app.py .

ENV PORT=10000
EXPOSE 10000

CMD ["python3", "app.py"]
